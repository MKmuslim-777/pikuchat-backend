# Server
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL (comma-separated for multiple origins)
# Example: https://pikuchat.vercel.app,https://www.pikuchat.app
CLIENT_URL=https://your-frontend.vercel.app

# JWT
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars

# Web Push (generate a matching public/private pair with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@pikuchat.app

# Cloudinary (Primary - Images, Banners)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary (Audio / Voice Messages Only)
CLOUDINARY_AUDIO_CLOUD_NAME=pikuchataudio
CLOUDINARY_AUDIO_API_KEY=197129336961838
CLOUDINARY_AUDIO_API_SECRET=_tkAS9Vww3-gFsUDPmagJxpJenU

# Redis (optional — for multi-instance Socket.io scaling)
# Leave empty for single instance
REDIS_URL=
